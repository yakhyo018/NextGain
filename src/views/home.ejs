<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<body>
  <!-- ===== HERO ===== -->
  <section class="hero">
    <canvas id="networkCanvas"></canvas>
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>

    <!-- Suzib yuruvchi sport figuralari -->
    <div class="floaters">
      <!-- Gantel (dumbbell) -->
      <svg class="floater floater--1" viewBox="0 0 64 24">
        <rect x="0" y="4" width="10" height="16" rx="2" />
        <rect x="6" y="0" width="4" height="24" rx="1" />
        <rect x="26" y="10" width="12" height="4" rx="1" />
        <rect x="54" y="0" width="4" height="24" rx="1" />
        <rect x="54" y="4" width="10" height="16" rx="2" />
      </svg>

      <!-- Kettlebell -->
      <svg class="floater floater--2" viewBox="0 0 40 44">
        <path d="M14 10a6 6 0 0 1 12 0v4H14v-4Z" />
        <circle cx="20" cy="28" r="15" />
      </svg>

      <!-- Protein shaker -->
      <svg class="floater floater--3" viewBox="0 0 28 48">
        <rect x="4" y="0" width="20" height="8" rx="2" />
        <path d="M6 8h16l-2 38a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2L6 8Z" />
      </svg>

      <!-- Gantel (kichik) -->
      <svg class="floater floater--4" viewBox="0 0 64 24">
        <rect x="0" y="4" width="10" height="16" rx="2" />
        <rect x="6" y="0" width="4" height="24" rx="1" />
        <rect x="26" y="10" width="12" height="4" rx="1" />
        <rect x="54" y="0" width="4" height="24" rx="1" />
        <rect x="54" y="4" width="10" height="16" rx="2" />
      </svg>

      <!-- Trophy / medal -->
      <svg class="floater floater--5" viewBox="0 0 24 32">
        <circle cx="12" cy="10" r="9" />
        <path d="M8 24h8l2 8H6l2-8Z" />
        <path d="M9 18h6v6H9z" />
      </svg>

      <!-- Weight plate -->
      <svg class="floater floater--6" viewBox="0 0 32 32">
        <circle cx="16" cy="16" r="15" />
        <circle cx="16" cy="16" r="5" />
      </svg>
    </div>

    <div class="hero__content">
      <span class="hero__eyebrow">NEXTGAIN</span>
      <h1 class="hero__title">Fuel Your<br /><span>Best Performance</span></h1>
      <p class="hero__subtitle">
        Premium supplements for strength, recovery, and results. Manage your
        store from one powerful dashboard.
      </p>
      <div class="hero__actions">
        <a href="/admin/login" class="hero__btn hero__btn--primary"
          >Get Started</a
        >
        <a href="/admin/signup" class="hero__btn hero__btn--ghost"
          >Create Account</a
        >
      </div>
    </div>
  </section>

  <script src="home.js"></script>
</body>

<%- include('includes/footer') %>
