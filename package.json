{
  "name": "burak",
  "version": "1.0.0",
  "description": "This burak project backend",
  "main": "src/server.ts",
  "scripts": {
    "start:dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/views','dist/views',{recursive:true});fs.cpSync('src/public','dist/public',{recursive:true})\"",
    "start": "node dist/server.js",
    "start:prod": "npm run build && pm2 start ecosystem.config.js",
    "restart:prod": "npm run build && pm2 restart nextgain",
    "stop:prod": "pm2 stop nextgain",
    "logs": "pm2 logs nextgain",
    "train": "nodemon --exec ts-node src/train.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "MIT",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongodb-session": "^3.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "ejs": "^3.1.6",
    "express": "^4.17.3",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongodb": "^3.2.6",
    "mongoose": "^6.2.9",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.3",
    "@types/connect-mongodb-session": "^2.4.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.3",
    "@types/express-session": "^1.17.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
